@model UserLogin.Models.ViewModels.VerifyOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Verify Code</h2>
        <p class="text-center text-muted mb-4">
            We've sent a 6-digit code to your email.<br />
            Please enter it below.
        </p>
        
        <form asp-action="VerifyOtp" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="Email" />
            
            <div class="mb-3">
                <label asp-for="Otp" class="form-label">Verification Code</label>
                <input asp-for="Otp" class="form-control text-center"
                       maxlength="6" placeholder="000000"
                       style="font-size: 1.5rem; letter-spacing: 5px;" />
                <span asp-validation-for="Otp" class="text-danger"></span>
            </div>
            
            <button type="submit" class="btn btn-primary w-100">Verify Code</button>
            
            <div class="text-center mt-3">
                <a asp-action="ForgotPassword" class="text-decoration-none">Request New Code</a>
                &nbsp;|&nbsp;
                <a asp-action="Login" class="text-decoration-none">Back to Login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}